{
    "family": "ava-task",
    "networkMode": "awsvpc",
    "executionRoleArn": "arn:aws:iam::524390297205:role/ecsTaskExecutionRole",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "512",
    "memory": "1024",
    "containerDefinitions": [
        {
            "name": "ava-container",
            "image": "524390297205.dkr.ecr.ap-south-1.amazonaws.com/ashritw/project-ava:latest",
            "portMappings": [
                { "containerPort": 8501, "hostPort": 8501, "protocol": "tcp" }
            ],
            "essential": true,
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/ava-task",
                    "awslogs-region": "ap-south-1",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ]
}